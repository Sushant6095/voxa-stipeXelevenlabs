# =============================================================================
# Voxa — environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# All NEXT_PUBLIC_* values ship to the browser — keep secrets out of them.
# =============================================================================

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === Auth: Clerk (Google OAuth only for hackathon) ===
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# === Database: Supabase ===
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only — never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# === Billing: Stripe (test mode for hackathon) ===
# Use sk_test_... in dev. apiVersion is pinned to 2025-03-31.basil in lib/stripe.ts.
STRIPE_SECRET_KEY=sk_test_...
# Generated when you run `stripe listen` or in the Stripe dashboard webhook page.
STRIPE_WEBHOOK_SECRET=whsec_...

# Created by scripts/setup-stripe.ts. Three tiers x (flat + metered) = six prices.
STRIPE_PRICE_STARTER_FLAT=price_...
STRIPE_PRICE_STARTER_METER=price_...
STRIPE_PRICE_GROWTH_FLAT=price_...
STRIPE_PRICE_GROWTH_METER=price_...
STRIPE_PRICE_SCALE_FLAT=price_...
STRIPE_PRICE_SCALE_METER=price_...

# === Telephony: Twilio ===
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# WhatsApp Business sandbox sender. Recipients must opt in by texting the join code.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional: default sender for transactional SMS (sendSMS in lib/twilio.ts).
# Must be a Twilio-owned, SMS-capable number in E.164. Omit if you always pass `from`.
TWILIO_SMS_FROM=+1...

# === Voice + Conv AI: ElevenLabs ===
ELEVENLABS_API_KEY=...
# Optional: webhook signing secret for /api/elevenlabs/webhook verification.
ELEVENLABS_WEBHOOK_SECRET=...

# === AI: Anthropic (post-call lead extraction + summary) ===
ANTHROPIC_API_KEY=sk-ant-...

# === Orchestration: n8n (self-hosted on Railway) ===
N8N_WEBHOOK_BASE_URL=https://your-n8n.up.railway.app

# === Voxa internal ===
# Shared secret for service-to-service calls (n8n → /api/agent/create).
# Generate a 32+ character random string: `openssl rand -hex 32`.
VOXA_INTERNAL_SECRET=
# Populated by `pnpm setup:el-agent --write-env`.
DEMO_AGENT_ID=
