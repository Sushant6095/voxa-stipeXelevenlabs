    {
      "parameters": {
        "jsCode": "// invoice_payment_failed arrives with the raw Stripe event; pull the\n// subscription id off event.data.object so we can look up business_id.\nconst body = $('Webhook (POST /stripe-webhook)').first().json.body || {};\nconst event = body.event || {};\nconst object = event?.data?.object || {};\nconst subscriptionId = typeof object.subscription === 'string'\n  ? object.subscription\n  : (object.subscription?.id ?? null);\nconst customerId = typeof object.customer === 'string'\n  ? object.customer\n  : (object.customer?.id ?? null);\n\nreturn [{ json: { subscription_id: subscriptionId, stripe_customer_id: customerId } }];"
      },
