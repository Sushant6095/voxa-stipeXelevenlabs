          }
        ]
      ]
    },
    "HTTP el.phoneNumbers.assignAgent": {
      "main": [
        [
          {
            "node": "Supabase update agents",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Set error.context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Supabase update agents": {
      "main": [
        [
          {
            "node": "HTTP twilio.whatsapp.activation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
