  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false,
    "description": "Voxa Workflow 1 — provisions Twilio number + ElevenLabs agent + phone import + assignment after Stripe Checkout completes. Responds synchronously so /api/stripe/webhook can ACK Stripe within 4s. Errors on any HTTP step fall through to a Supabase status='failed' branch."
  }
